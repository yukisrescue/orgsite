{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yukis-rescue-org",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Only the generated export is deployed. Before this, the assets directory
  // was the repository root, which would have published deploy/, docs/,
  // legacy/ and node_modules to the public site.
  "assets": {
    "directory": "./site"
  },
  // Plain zone routes, matching what is actually deployed. A previous
  // wildcard route (*.yukisrescue.org/*) also captured control.yukisrescue.org
  // and prevented the authoring host from reaching the origin; it was removed
  // 2026-09-07 and replaced with these two explicit routes.
  "routes": [
    { "pattern": "www.yukisrescue.org/*", "zone_name": "yukisrescue.org" },
    { "pattern": "yukisrescue.org/*",     "zone_name": "yukisrescue.org" }
  ]
}
