{
  "name": "yukis-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // A separate Worker on a route, not merged into the site Worker. The site
  // Worker is assets-only; adding a script entry point to it would complicate
  // every content deploy for the sake of one endpoint.
  "routes": [
    { "pattern": "www.yukisrescue.org/api/contact", "zone_name": "yukisrescue.org" }
  ],
  "vars": {
    "TO_EMAIL": "hello@yukisrescue.org",
    // Resend's verified domain. DKIM lives on ruff.yukisrescue.org; the MX and
    // SPF for bounce handling live on send.ruff.yukisrescue.org. Sending from a
    // subdomain keeps Resend's SPF isolated from the root domain, which carries
    // Cloudflare Email Routing and permits only one SPF record. DMARC on
    // yukisrescue.org is p=quarantine with relaxed alignment, so a subdomain
    // sender aligns against the organizational domain and passes.
    "FROM_EMAIL": "noreply@ruff.yukisrescue.org"
  }
}
